PORT=port_numbers
DATABASE_NAME="db_name"
DATABASE_USER="user_name"
DATABASE_PASSWORD="password"
DATABASE_HOST="localhost"
DATABASE_DIALECT=mysql
DATABASE_PORT="3306"
JWT_SECRET="some_secret_key"
JWT_EXPIRES_IN="1h"
# Hoja de ruta: Google Maps Routes API (ruta optima y km estimados). Habilitar "Routes API" en Google Cloud
GOOGLE_MAPS_API_KEY=""
# Direccion de la base/deposito: la ruta sale y vuelve a este punto (opcional)
HOJA_RUTA_ORIGEN=""
# Opcional: key de Maps Embed API (se expone al navegador: restringila por referrer). Sin ella se usa el mapa embebido clasico
GOOGLE_MAPS_EMBED_API_KEY=""
# Opcional: localidad que se agrega a las direcciones sin ciudad (por defecto, la de HOJA_RUTA_ORIGEN)
HOJA_RUTA_CIUDAD=""
# Opcional: km por encima de los cuales se advierte una posible direccion mal resuelta (por defecto 300)
HOJA_RUTA_KM_ALERTA=""
